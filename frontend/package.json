{
  "name": "ai-learning-platform-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:unit": "node --experimental-strip-types --test tests/unit/course-logic.test.mts tests/unit/api-request.test.mts && node -e \"console.log('FRONTEND_UNIT_TESTS_OK')\"",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "validate:a1": "node scripts/validate-a1-content.mjs && node scripts/validate-additional-vocabulary.mjs && node scripts/validate-test-option-order.cjs && tsc --noEmit --incremental false",
    "test:ui": "node scripts/run-ui-tests.mjs"
  },
  "dependencies": {
    "next": "~15.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@openai/codex": "^0.149.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "nanoid": "^3.3.19",
    "sharp": "^0.35.4"
  }
}
